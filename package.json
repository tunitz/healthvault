{
  "name": "healthvault",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hosted personal health, nutrition, training, and Apple Health analytics dashboard with an MCP server.",
  "license": "MIT",
  "author": "tunitz",
  "homepage": "https://github.com/tunitz/healthvault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunitz/healthvault.git"
  },
  "bugs": {
    "url": "https://github.com/tunitz/healthvault/issues"
  },
  "keywords": [
    "apple-health",
    "health",
    "nutrition",
    "fitness",
    "nextjs",
    "sqlite",
    "mcp",
    "self-hosted"
  ],
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun test --isolate",
    "test:src": "bun test --isolate src/",
    "typecheck": "next typegen && tsc --noEmit",
    "rust:build": "rust-anything build rust/xml-rs && cargo build --release --manifest-path rust/ingest-rs/Cargo.toml && cp rust/ingest-rs/target/release/healthvault-ingest rust/ingest-rs/healthvault-ingest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate-db.ts",
    "db:backup": "bun scripts/backup-db.ts",
    "password:set": "bun scripts/password.ts set",
    "password:verify": "bun scripts/password.ts verify"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "sax": "^1.6.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sax": "^1.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
