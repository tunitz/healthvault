# HealthVault configuration template.
#
# Easiest path: run `bun run password:set` — it prompts for the login password
# (hidden input) and creates this file for you (.env, mode 0600, git-ignored)
# with the password hash, a generated session secret, and the agent token file.
# This template documents the format for manual or Docker setups.
#
# There is no auth-off mode: the server refuses to boot without valid credentials.

# SQLite database location (container path when using docker-compose).
DATABASE_PATH=/data/health.db

# scrypt password hash, format: scrypt:<N>:<r>:<p>:<saltHex>:<hashHex>
# Generated by `bun run password:set`; never commit the result, never pass the
# password as a CLI argument.
HEALTHVAULT_PASSWORD_HASH=

# Session cookie HMAC secret: openssl rand -hex 32
HEALTHVAULT_SESSION_SECRET=

# Agent/MCP bearer token (wins over HEALTHVAULT_API_TOKEN_FILE): openssl rand -hex 32
# Write the SAME value to ~/.config/healthvault/token (0600) for MCP clients.
HEALTHVAULT_API_TOKEN=

# Optional overrides
#HEALTHVAULT_API_TOKEN_FILE=/run/healthvault/token
#HEALTHVAULT_SESSION_DAYS=30
# Set to 1 only when serving over HTTPS (e.g. behind deploy/Caddyfile.example).
#HEALTHVAULT_COOKIE_SECURE=1
