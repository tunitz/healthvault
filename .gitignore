# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite
/data/
*.db-wal
*.db-shm

# playwright-cli session artifacts
/.playwright-cli/

# plugin build artifacts
/plugins/*/dist/
/plugins/*/coverage/
/plugins/*/node_modules/

# caches, temp files, logs
/.cache/
/tmp/
*.log
*.bak
